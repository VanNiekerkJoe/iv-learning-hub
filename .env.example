# Browser-visible build-time values. Use only the Supabase publishable key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server/Worker runtime values for authenticated Supabase functions.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Required for administrator invitations. Server-only; never expose to browser code.
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection for local/CI migration tooling only; not a Vercel runtime variable.
DATABASE_URL=
